# Copy to .env (gitignored) or ~/.tarrafa/.env
# tarrafa loads both at CLI startup (does not override existing process env).

# Optional: Playwright MCP browser extension token
# (e.g. from @playwright/mcp --extension)
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# Optional Datajud quota key. Prefer env over the --api-key CLI option.
DATAJUD_API_KEY=

# Descoberta web. Configure ao menos um provedor para `tarrafa search`.
# Brave usa índice oficial; SearXNG requer instância com saída JSON habilitada.
BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=https://searx.example.org

# Optional global defaults (uncomment as needed).
# TARRAFA_WORKSPACE=
# TARRAFA_TIMEOUT=30
# TARRAFA_FORCE=false
# TARRAFA_NO_CLOBBER=true
# TARRAFA_RECORD_RUNS=true
